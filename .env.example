# Copie para .env.local (uso local) e cadastre as mesmas variáveis na Vercel:
# Project > Settings > Environment Variables.

# BravoPay (https://bravopay.club/dashboard/api-keys). bp_live_... Só no servidor.
BRAVOPAY_API_KEY=
# ID do produto em https://bravopay.club/dashboard/produtos (necessário para a UTMify nativa da BravoPay)
BRAVOPAY_PRODUCT_ID=

# Meta Pixel + API de Conversões (Gerenciador de Eventos > Configurações)
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Opcional, só para testar: código da aba "Testar eventos" (ex.: TEST12112). Apague depois.
META_TEST_EVENT_CODE=

# Endereço do site publicado, sem barra no final. Usado no webhook e no CORS.
SITE_URL=https://seudominio.com.br

# Link onde o cliente acessa o produto (Drive, área de membros, PDF...).
# Aparece no botão da tela de sucesso e no e-mail. Só é revelado depois do pagamento.
PRODUCT_ACCESS_URL=

# Envio automático do e-mail de acesso (https://resend.com). Opcional.
RESEND_API_KEY=
EMAIL_FROM=Idade Conecta <acesso@seudominio.com.br>
SUPPORT_EMAIL=

# UTMify própria (opcional). Deixe VAZIO se a UTMify já estiver ligada na aba Integrações da BravoPay,
# senão a venda aparece duas vezes. Token: UTMify > Integrações > Webhooks > Credenciais de API.
UTMIFY_API_TOKEN=
# Taxa do gateway por venda, em centavos (opcional)
UTMIFY_GATEWAY_FEE_CENTS=
# true = a UTMify só valida, sem salvar (para testes)
UTMIFY_IS_TEST=

# Chave para criptografar os dados de rastreamento (opcional; se vazio, usa BRAVOPAY_API_KEY)
TRACKING_SECRET=

# Upstash Redis (Vercel > Storage > Marketplace > Upstash for Redis > Connect).
# Criadas automaticamente pela Vercel. Guardam os dados do pedido para o webhook.
KV_REST_API_URL=
KV_REST_API_TOKEN=
